<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pw_background"
    tools:context=".RegisterActivity">

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===== Шапка с аркой ===== -->
            <View
                android:id="@+id/headerBackground"
                android:layout_width="500dp"
                android:layout_height="500dp"
                android:translationX="0dp"
                android:translationY="-290dp"
                android:background="@drawable/bg_header_arch"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="45dp"
                android:src="@drawable/ic_paw_house"
                app:tint="@color/pw_text_on_header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/logoText"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <TextView
                android:id="@+id/logoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="PAWINDER"
                android:textColor="@color/pw_text_on_header"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                app:layout_constraintTop_toTopOf="@id/logoIcon"
                app:layout_constraintBottom_toBottomOf="@id/logoIcon"
                app:layout_constraintStart_toEndOf="@id/logoIcon"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Таб с названием экрана ===== -->
            <TextView
                android:id="@+id/screenTitleTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Регистрация"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/logoIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Поле "Логин" ===== -->
            <TextView
                android:id="@+id/labelLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="50dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="Логин"
                android:textColor="@color/pw_text_dark"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/screenTitleTab"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etLogin"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="nickname"
                android:textColorHint="@color/pw_input_hint"
                android:textColor="@color/pw_input_text"
                android:inputType="text"
                android:autofillHints="username"
                app:layout_constraintTop_toBottomOf="@id/labelLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Поле "Почта" ===== -->
            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Почта"
                android:textColor="@color/pw_text_dark"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/etLogin"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="nickname@mail.com"
                android:textColorHint="@color/pw_input_hint"
                android:textColor="@color/pw_input_text"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                app:layout_constraintTop_toBottomOf="@id/labelEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Поле "Пароль" ===== -->
            <TextView
                android:id="@+id/labelPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Пароль"
                android:textColor="@color/pw_text_dark"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/etEmail"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="********"
                android:textColorHint="@color/pw_input_hint"
                android:textColor="@color/pw_input_text"
                android:inputType="textPassword"
                android:autofillHints="password"
                app:layout_constraintTop_toBottomOf="@id/labelPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Поле "Повторите пароль" ===== -->
            <TextView
                android:id="@+id/labelPasswordRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Повторите пароль"
                android:textColor="@color/pw_text_dark"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/etPassword"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etPasswordRepeat"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="********"
                android:textColorHint="@color/pw_input_hint"
                android:textColor="@color/pw_input_text"
                android:inputType="textPassword"
                android:autofillHints="password"
                app:layout_constraintTop_toBottomOf="@id/labelPasswordRepeat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== Кнопки "Back" и "Зарегистрироваться" ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="32dp"
                app:backgroundTint="@color/pw_button_tan"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_back"
                app:iconTint="@color/pw_text_on_tan"
                app:iconGravity="textStart"
                app:iconSize="30dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/etPasswordRepeat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnRegister"
                app:layout_constraintHorizontal_chainStyle="spread_inside" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="250dp"
                android:layout_height="58dp"
                android:layout_marginEnd="34dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="32dp"
                app:backgroundTint="@color/pw_button_brown"
                app:cornerRadius="10dp"
                android:text="Зарегистрироваться"
                android:textAllCaps="false"
                android:textColor="@color/pw_button_tan"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/etPasswordRepeat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>